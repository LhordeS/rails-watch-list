<div class="mb-100 banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://www.rotoscopers.com/wp-content/uploads/2020/01/20th_Century_Fox_logo_black_and_white.jpg);">
  <div class="container">
    <h1>Movie Watchlist</h1>
    <p>List all of your best and worst movie picks</p>
    <%# <a class="btn btn-danger" href="#">Create List</a> %>
  </div>
</div>


<div class="cards">
  <% @lists.each do |list| %>
   <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= list.photo.attached? ? cl_image_path(list.photo.key) : 'https://happiclap.com/wp-content/uploads/2019/06/Everyday-Clapboard-1.jpg' %>)">
    <span><%= list.name %></span>
    <%= link_to "", list_path(list), class: "card-category-link" %>
    <%= link_to "X", list_path(list), class: 'card-remove-link', data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{list.name}?"} %>
  </div>
  <% end %>
</div>

<div class="container text-warning">
  <h1>Create a New List</h1>
  <%= simple_form_for @list do |f| %>
    <%= f.input :name %>
    <%= f.input :photo, as: :file %>
    <%= f.submit class: "btn text-warning border border-warning"%>
  <% end %>
</div>
