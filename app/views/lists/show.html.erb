<div class="container">
  <h1 class="text-warning"><%= @list.name %> Movies</h1>
  <div class="cards">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="card" style="width: 18rem;">
        <%= image_tag bookmark.movie.poster_url %>
          <div class="card-body bg-dark">
            <p class="card-text text-warning"><%= bookmark.comment %></p>
            <%= link_to "X", bookmark_path(bookmark), class: 'card-remove-link', data: { turbo_method: :delete} %>
          </div>
      </div>
    <% end %>
  </div>
  <%= link_to "Add to this list", new_list_bookmark_path(@list) %>
  <%= link_to "Back to Lists", lists_path %>
</div>
